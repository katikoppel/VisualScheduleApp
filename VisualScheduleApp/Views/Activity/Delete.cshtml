@model VisualScheduleApp.Models.Activities.ActivityViewModel

@{
    ViewData["Title"] = "Kustuta tegevus";
}

<div class="app-page">
    <div class="app-card home-hero mb-4">
        <p class="page-label">Tegevus</p>
        <h1>Kustuta tegevus</h1>
        <p class="text-muted mb-0">
            Kas oled kindel, et soovid selle tegevuse kustutada?
        </p>
    </div>

    <div class="app-card">
        <div class="row align-items-center g-4">
            <div class="col-md-4 text-center">
                <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/noimage.png" : Model.ImagePath)" class="img-fluid rounded" style="max-height: 260px; object-fit: cover;" alt="@Model.Name" />
            </div>

            <div class="col-md-8">
                <p class="page-label">Nimi</p>
                <h2>@Model.Name</h2>
                <p class="page-label mt-4">Kirjeldus</p>
                <p class="text-muted">
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "Kirjeldus puudub." : Model.Description)
                </p>

                <form asp-action="DeleteConfirmation" method="post" class="mt-4 d-flex gap-2 flex-wrap">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">
                        Kustuta
                    </button>
                    <a asp-action="Index" asp-controller="Activity" class="btn btn-success">
                        Tagasi
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>