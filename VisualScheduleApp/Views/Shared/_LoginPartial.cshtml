@using Microsoft.AspNetCore.Identity
@using VisualScheduleApp.Core.Domain

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav ms-auto align-items-center gap-2">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);
        var displayName = !string.IsNullOrWhiteSpace(user?.Name) ? user.Name : user?.Email;

        <li class="nav-item">
            <a id="manage" class="nav-link user-nav-link" asp-controller="Home" asp-action="Index">
                <i class="bi bi-person-circle"></i>
                <span>Tere, @displayName!</span>
            </a>
        </li>

        <li class="nav-item">
            <form id="logoutForm"
                  asp-area="Identity"
                  asp-page="/Account/Logout"
                  asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                  method="post">

                <button id="logout" type="submit" class="nav-link logout-nav-button">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logi välja</span>
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link user-nav-link" id="login" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right"></i>
                <span>Logi sisse</span>
            </a>
        </li>

        <li class="nav-item">
            <a class="nav-link register-nav-link" id="register" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus"></i>
                <span>Registreeri</span>
            </a>
        </li>
    }
</ul>