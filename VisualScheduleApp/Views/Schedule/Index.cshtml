@model IEnumerable<VisualScheduleApp.Models.Schedules.ScheduleViewModel>

@{
    ViewData["Title"] = "Päevaplaanid";
}

<div class="app-page">
    <div class="app-card home-hero mb-4">
        <p class="page-label">Päevaplaanid</p>
        <h1>Kõik päevaplaanid</h1>
        <p class="text-muted mb-0">
            Siin saad vaadata, lisada ja hallata laste visuaalseid päevaplaane.
        </p>
    </div>

    <div class="d-flex justify-content-end mb-4">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Loo uus
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="app-grid">
            @foreach (var schedule in Model)
            {
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-3">@schedule.Name</h5>
                        <p class="text-muted mb-1">
                            <i class="bi bi-calendar"></i>
                            @schedule.Date.ToString("dd.MM.yyyy")
                        </p>
                        <p class="text-muted mb-3">
                            <i class="bi bi-person"></i>
                            @schedule.ChildName
                        </p>

                        <div class="mt-auto d-flex justify-content-center gap-2 flex-wrap">
                            <a asp-action="Details" asp-route-id="@schedule.Id" class="btn btn-primary btn-sm">
                                Ava
                            </a>
                            <a asp-action="Update" asp-route-id="@schedule.Id" class="btn btn-light btn-sm">
                                Uuenda
                            </a>
                            <a asp-action="Delete" asp-route-id="@schedule.Id" class="btn btn-danger btn-sm">
                                Kustuta
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="app-card text-center">
            <h4>Päevaplaane ei ole veel loodud</h4>
            <p class="text-muted">
                Alusta uue päevaplaani loomisega.
            </p>

            <a asp-action="Create" class="btn btn-primary">
                Loo esimene päevaplaan
            </a>
        </div>
    }

</div>