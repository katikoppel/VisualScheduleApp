@model VisualScheduleApp.Models.Schedules.ScheduleViewModel

@{
    ViewData["Title"] = "Kustuta päevaplaan";
}

<div class="app-page">
    <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
        <i class="bi bi-exclamation-triangle"></i>
        <div>
            <strong>Kustutamise kinnitus</strong><br />
            Kas oled kindel, et soovid selle päevaplaani kustutada?
        </div>
    </div>

    <div class="app-card">
        <p class="page-label">Päevaplaan</p>
        <h1>@Model.Name</h1>
        <div class="mt-4">
            <p class="text-muted mb-2">
                <i class="bi bi-calendar"></i>
                @Model.Date.ToString("dd.MM.yyyy")
            </p>
            <p class="text-muted mb-0">
                <i class="bi bi-person"></i>
                @Model.ChildName
            </p>
        </div>

        <form asp-action="DeleteConfirmation" method="post" class="mt-4 d-flex gap-2 flex-wrap">
            <input asp-for="Id" type="hidden" />
            <button type="submit" class="btn btn-danger">
                Kustuta
            </button>
            <a asp-action="Index" class="btn btn-success">
                Tagasi
            </a>
        </form>
    </div>
</div>