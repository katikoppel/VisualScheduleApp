@model VisualScheduleApp.Models.Children.ChildViewModel

@{
    ViewData["Title"] = Model.Id != Guid.Empty ? "Uuenda lapse infot" : "Lisa uus laps";
}

<div class="app-page">
    <div class="app-card home-hero mb-4">
        <p class="page-label">Laps</p>

        @if (Model.Id != Guid.Empty)
        {
            <h1>Uuenda lapse infot</h1>
            <p class="text-muted mb-0">Muuda olemasoleva lapse andmeid.</p>
        }
        else
        {
            <h1>Lisa uus laps</h1>
            <p class="text-muted mb-0">Lisa laps, kellele päevaplaani koostada.</p>
        }
    </div>

    <div class="app-card">
        <form method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="CreatedAt" type="hidden" />
            <input asp-for="ModifiedAt" type="hidden" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label">Nimi</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="BirthDate" class="form-label">Sünniaeg</label>
                <input asp-for="BirthDate" type="date" class="form-control" />
            </div>

            <div class="mt-4 d-flex gap-2 flex-wrap">
                @if (Model.Id != Guid.Empty)
                {
                    <button asp-action="Update" asp-controller="Child" type="submit" class="btn btn-primary">
                        Uuenda
                    </button>
                }
                else
                {
                    <button asp-action="Create" asp-controller="Child" type="submit" class="btn btn-primary">
                        Lisa uus
                    </button>
                }

                <a asp-action="Index" asp-controller="Child" class="btn btn-success">
                    Tagasi
                </a>
            </div>
        </form>
    </div>
</div>