@model IEnumerable<VisualScheduleApp.Models.Children.ChildViewModel>

@{
    ViewData["Title"] = "Lapsed";
}

<div class="app-page">
    <div class="app-card home-hero mb-4">
        <p class="page-label">Lapsed</p>
        <h1>Lapsed</h1>
        <p class="text-muted mb-0">
            Siin saad hallata lapsi, kellele koostatakse visuaalseid päevaplaane.
        </p>
    </div>
    <div class="d-flex justify-content-end mb-4">
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Lisa uus
        </a>
    </div>
    @if (Model != null && Model.Any())
    {
        <div class="app-grid">
            @foreach (var child in Model)
            {
                <div class="card h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title mb-3">@child.Name</h5>
                        <p class="text-muted mb-1">
                            <strong>Sünniaeg:</strong> @child.BirthDate.ToString("dd.MM.yyyy")
                        </p>
                        <p class="text-muted mb-3">
                            <strong>Vanus:</strong> @child.Age
                        </p>

                        <div class="mt-auto d-flex justify-content-center gap-2 flex-wrap">
                            <a asp-action="Details" asp-route-id="@child.Id" class="btn btn-success btn-sm">
                                Detailid
                            </a>
                            <a asp-action="Update" asp-route-id="@child.Id" class="btn btn-primary btn-sm">
                                Uuenda
                            </a>
                            <a asp-action="Delete" asp-route-id="@child.Id" class="btn btn-danger btn-sm">
                                Kustuta
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="app-card text-center">
            <h4>Lapsi ei ole veel lisatud.</h4>
            <p class="text-muted">
                Alusta uue lapse lisamisega.
            </p>
            <a asp-action="Create" class="btn btn-primary">
                Lisa esimene laps
            </a>
        </div>
    }
</div>