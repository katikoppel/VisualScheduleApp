@model VisualScheduleApp.Models.Children.ChildViewModel

@{
    ViewData["Title"] = "Kustuta";
}

<h1>Kustuta</h1>

<div class="alert alert-danger">
    Kas oled kindel, et soovid selle lapse süsteemist eemaldada?
</div>

<div class="card">
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">Nimi</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Sünniaeg</dt>
            <dd class="col-sm-9">@Model.BirthDate.ToShortDateString()</dd>

            <dt class="col-sm-3">Vanus</dt>
            <dd class="col-sm-9">@Model.Age</dd>
        </dl>

        <form asp-action="DeleteConfirmation" method="post">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="btn btn-danger">Kustuta</button>
            <a asp-action="Index" class="btn btn-primary">Tagasi</a>
        </form>
    </div>
</div>