@model VisualScheduleApp.Models.Children.ChildViewModel

@{
    ViewData["Title"] = "Kustuta laps";
}

<div class="app-page">
    <div class="app-card home-hero mb-4">
        <p class="page-label">Laps</p>
        <h1>Kustuta laps</h1>
        <p class="text-muted mb-0">
            Kas oled kindel, et soovid selle lapse kustutada?
        </p>
    </div>

    <div class="app-card">
        <div class="row align-items-center g-4">

            <div class="col-md-8">
                <p class="page-label">Nimi</p>
                <h2>@Model.Name</h2>

                <p class="page-label mt-4">Sünniaeg</p>
                <p class="text-muted">
                    @Model.BirthDate.ToString("dd.MM.yyyy")
                </p>

                <p class="page-label mt-4">Vanus</p>
                <p class="text-muted">
                    @Model.Age
                </p>

                <form asp-action="DeleteConfirmation" method="post" class="mt-4 d-flex gap-2 flex-wrap">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <button type="submit" class="btn btn-danger">
                        Kustuta
                    </button>

                    <a asp-action="Index" asp-controller="Child" class="btn btn-success">
                        Tagasi
                    </a>
                </form>
            </div>

        </div>
    </div>
</div>