@model VisualScheduleApp.Models.Children.ChildViewModel

@{
    ViewData["Title"] = "Lapse detailid";
}

<div class="app-page">
    <div class="app-card home-hero mb-4">
        <p class="page-label">Laps</p>
        <h1>Lapse detailid</h1>
        <p class="text-muted mb-0">
            Siin näed valitud lapse andmeid.
        </p>
    </div>

    <div class="app-card">
        <div class="row align-items-center g-4">
            <div class="col-md-8">
                <p class="page-label">Nimi</p>
                <h2>@Model.Name</h2>

                <p class="page-label mt-4">Sünniaeg</p>
                <p class="text-muted">
                    @Model.BirthDate.ToString("dd.MM.yyyy")
                </p>

                <p class="page-label mt-4">Vanus</p>
                <p class="text-muted">
                    @Model.Age
                </p>

                <p class="page-label mt-4">Lisainfo</p>
                <p class="text-muted mb-1">
                    <strong>Loodud:</strong> @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </p>
                <p class="text-muted mb-0">
                    <strong>Muudetud:</strong> @Model.ModifiedAt.ToString("dd.MM.yyyy HH:mm")
                </p>

                <div class="d-flex gap-2 flex-wrap mt-4">
                    <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-primary">
                        Uuenda
                    </a>

                    <a asp-action="Index" asp-controller="Child" class="btn btn-success">
                        Tagasi
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>