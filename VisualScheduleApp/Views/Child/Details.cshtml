@model VisualScheduleApp.Models.Children.ChildViewModel

@{
    ViewData["Title"] = "Lapse detailne info";
}

<h1>Lapse detailne info</h1>

<div class="card">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <hr />

        <dl class="row">
            <dt class="col-sm-3">Nimi</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">Sünniaeg</dt>
            <dd class="col-sm-9">@Model.BirthDate.ToShortDateString()</dd>

            <dt class="col-sm-3">Vanus</dt>
            <dd class="col-sm-9">@Model.Age</dd>

            <dt class="col-sm-3">Loodud</dt>
            <dd class="col-sm-9">@Model.CreatedAt</dd>

            <dt class="col-sm-3">Muudetud</dt>
            <dd class="col-sm-9">@Model.ModifiedAt</dd>
        </dl>

        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-success">Uuenda</a>
        <a asp-action="Index" class="btn btn-danger">Tagasi</a>
    </div>
</div>