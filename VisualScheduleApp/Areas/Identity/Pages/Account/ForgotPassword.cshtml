@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Unustasid parooli";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

                <div class="text-center mb-4">
                    <i class="bi bi-key display-4 text-secondary"></i>
                    <h2 class="mt-3">Unustasid parooli?</h2>
                    <p class="text-muted">Sisesta oma e-posti aadress ja saadame sulle peagi parooli taastamise lingi.</p>
                </div>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="email@email.com" />
                        <label asp-for="Input.Email">E-post</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <button type="submit" class="w-100 btn btn-dark btn-lg rounded-pill">
                        <i class="bi bi-envelope me-1"></i> Saada
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}