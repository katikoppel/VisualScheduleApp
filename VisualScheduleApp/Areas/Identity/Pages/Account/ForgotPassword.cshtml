@page
@model ForgotPasswordModel

@{
    ViewData["Title"] = "Unustasid parooli";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="bi bi-key display-5" style="color:#6d5dfc;"></i>
            <h2 class="mt-2">Kas unustasid parooli?</h2>
            <p class="text-muted">
                Sisesta oma e-posti aadress ja saadame sulle peagi parooli taastamise lingi.
            </p>
        </div>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" placeholder="E-post" />
                <label asp-for="Input.Email">E-post</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-primary">
                <i class="bi bi-envelope me-1"></i> Saada
            </button>
        </form>
        <div class="text-center mt-3">
            <a asp-page="./Login">Tagasi sisselogimisele</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}