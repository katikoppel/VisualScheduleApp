@page
@model LoginModel

@{
    ViewData["Title"] = "Logi sisse";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4">

                <div class="text-center mb-4">
                    <i class="bi bi-person-circle display-4 text-secondary"></i>
                    <h2 class="mt-3">Logi sisse</h2>
                </div>

                <form id="account" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="email@email.com" />
                        <label asp-for="Input.Email">E-post</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="Parool" />
                        <label asp-for="Input.Password">Parool</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe">
                            Jäta mind meelde
                        </label>
                    </div>

                    <button id="login-submit" type="submit" class="w-100 btn btn-dark btn-lg rounded-pill">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Logi sisse
                    </button>

                    <div class="text-center mt-3">
                        <p class="mb-1">
                            <a id="forgot-password" asp-page="./ForgotPassword">Unustasid parooli?</a>
                        </p>
                        <p class="mb-1">
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Loo uus konto</a>
                        </p>
                        <p class="mb-0">
                            <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Saada kinnituskiri uuesti</a>
                        </p>
                    </div>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <hr class="my-4" />

                    <div class="text-center">
                        <p class="text-muted mb-3">Või logi sisse teise teenusega</p>

                        <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                <button type="submit"
                                        class="w-100 btn btn-outline-dark rounded-pill"
                                        name="provider"
                                        value="@provider.Name"
                                        title="Logi sisse kasutades @provider.DisplayName kontot">
                                    <i class="bi bi-google me-1"></i> Logi sisse Google kontoga
                                </button>
                            }
                        </form>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}