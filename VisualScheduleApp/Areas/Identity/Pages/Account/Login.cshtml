@page
@model LoginModel

@{
    ViewData["Title"] = "Logi sisse";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="text-center mb-4">
            <i class="bi bi-person-circle display-5" style="color:#6d5dfc;"></i>
            <h2 class="mt-2">Tere tulemast tagasi!</h2>
            <p class="text-muted">Logi sisse oma kontole</p>
        </div>
        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" placeholder="E-post" />
                <label asp-for="Input.Email">E-posti aadress</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" placeholder="Parool" />
                <label asp-for="Input.Password">Parool</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label class="form-check-label" asp-for="Input.RememberMe">
                    Jäta mind meelde
                </label>
            </div>
            <button id="login-submit" type="submit" class="w-100 btn btn-primary">
                <i class="bi bi-box-arrow-in-right me-1"></i> Logi sisse
            </button>
        </form>

        <div class="text-center mt-3">
            <p class="mb-1">
                <a asp-page="./ForgotPassword">Unustasid parooli?</a>
            </p>
            <p class="mb-1">
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">
                    Loo uus konto
                </a>
            </p>
        </div>

        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <div class="auth-divider">
                <span>või</span>
            </div>

            <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                @foreach (var provider in Model.ExternalLogins!)
                {
                    <button type="submit" class="google-btn mb-2" name="provider" value="@provider.Name">
                        @if (provider.Name == "Google")
                        {
                            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" />
                        }
                        Logi sisse @provider.DisplayName kontoga
                    </button>
                }
            </form>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}