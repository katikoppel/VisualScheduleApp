@page
@model ExternalLoginModel

@{
    ViewData["Title"] = "Registreeru";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="text-center mb-4">
            @if (Model.ProviderDisplayName == "Google")
            {
                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" style="width:42px;" />
            }
            else
            {
                <i class="bi bi-box-arrow-in-right display-5" style="color:#6d5dfc;"></i>
            }
            <h2 class="mt-3">@Model.ProviderDisplayName konto</h2>
            <p class="text-muted">
                Lõpeta konto loomine
            </p>
        </div>

        <p class="text-muted text-center mb-4">
            Oled edukalt sisse loginud <strong>@Model.ProviderDisplayName</strong> kontoga.
            Sisesta oma e-posti aadress ja vajuta „Registreeru“, et konto loomine lõpuni viia.
        </p>
        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="E-post" />
                <label asp-for="Input.Email">E-post</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-primary">
                <i class="bi bi-person-plus me-1"></i> Registreeru
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}