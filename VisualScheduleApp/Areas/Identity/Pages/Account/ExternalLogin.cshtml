@page
@model ExternalLoginModel

@{
    ViewData["Title"] = "Registreeru";
}

<div class="app-page">
    <div class="app-card home-hero mb-4 text-center">
        <p class="page-label">Kasutajakonto</p>
        <h1>Registreeru</h1>
        <p class="text-muted mb-0">
            Lõpeta sisselogimine @Model.ProviderDisplayName kontoga.
        </p>
    </div>
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="app-card">
                <div class="text-center mb-4">
                    <i class="bi bi-google display-4" style="color:#6d5dfc;"></i>
                    <h2 class="mt-3">@Model.ProviderDisplayName konto</h2>
                </div>
                <p class="text-muted text-center mb-4">
                    Oled edukalt sisse loginud <strong>@Model.ProviderDisplayName</strong> kontoga.
                    Sisesta oma e-posti aadress ja vajuta „Registreeru“, et konto loomine lõpetada.
                </p>
                <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" autocomplete="email" />
                        <label asp-for="Input.Email">E-post</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <button type="submit" class="w-100 btn btn-primary">
                        <i class="bi bi-person-plus me-1"></i> Registreeru
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}