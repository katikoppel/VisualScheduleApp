@page
@model ConfirmEmailModel

@{
    ViewData["Title"] = "E-posti aadressi kinnitamine";
}

<div class="auth-page">
    <div class="auth-card text-center">
        <i class="bi bi-check-circle display-4 text-success mb-3"></i>
        <h2>Sinu e-posti aadress on kinnitatud!</h2>

        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <p class="text-muted mt-3">@Model.StatusMessage</p>
        }

        <a asp-page="./Login" class="btn btn-primary mt-4 w-100">
            Logi sisse
        </a>
    </div>
</div>